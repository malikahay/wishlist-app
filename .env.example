# Token from @BotFather
BOT_TOKEN=
# Any random string; Telegram sends it back in a header so only Telegram can call /api/bot
WEBHOOK_SECRET=
# Bot username without @ (used for share links t.me/<bot>?startapp=<id>)
NEXT_PUBLIC_BOT_USERNAME=
# Public https URL of the app
APP_URL=
# Filled automatically by the Upstash Redis integration on Vercel
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Optional: ScrapingBee key — second attempt for shops that block bots
SCRAPINGBEE_API_KEY=
# Screenshot recognition via GLM (Z.ai); GLM_MODEL overrides the default model list
ZAI_API_KEY=
GLM_MODEL=
# Optional: call Claude directly instead of via Vercel AI Gateway
ANTHROPIC_API_KEY=
